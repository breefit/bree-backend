# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database (MySQL) ─────────────────────────────────────────────────────────
# Pooled URL — for all app queries
DATABASE_URL="mysql://user:pass@127.0.0.1:3306/bree"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be 64+ random chars each — NEVER share or commit
JWT_SECRET=change_me_to_a_very_long_random_string_minimum_64_characters
# Access token only — short-lived by design, NOT the session length. The
# customer's effective session persists for REFRESH_TOKEN_EXPIRES_IN_DAYS
# (below) via the refresh-token mechanism; GET /api/auth/verify silently
# reissues this token from a valid refresh token whenever it's expired.
JWT_EXPIRES_IN=7d
# Customer session length (days). Governs both the refresh-token database
# row's expiry (src/services/authService.js) and the refresh-token
# cookie's maxAge (src/utils/jwt.js) — both are derived from this single
# value, so they cannot disagree.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
ADMIN_JWT_SECRET=a_different_very_long_secret_for_admin_minimum_64_chars
# Admin session length. Admin has no separate refresh-token mechanism, so
# this value directly IS the admin session length — it also drives the
# admin cookie's maxAge (src/utils/jwt.js).
ADMIN_JWT_EXPIRES_IN=7d

# ── Firebase Admin Service Account — required for verifying Google ID tokens
# LOW-24 fix (Phase 4 doc audit): src/config/firebaseAdmin.js's active code
# path only ever loads a service-account JSON FILE — via
# GOOGLE_APPLICATION_CREDENTIALS if set, otherwise a serviceAccountKey.json
# file it looks for directly in the backend root. Set the path to your own
# downloaded Firebase service-account JSON below. (An alternate
# inline-env-var credential path — FIREBASE_PROJECT_ID/CLIENT_EMAIL/
# PRIVATE_KEY — exists in that file but is currently commented out/unused;
# don't rely on it.)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ── Admin Seed (used by: node migrations/seed.js) ────────────────────────────
ADMIN_EMAIL=demo@bree.fit
ADMIN_PASSWORD=Change_Me_Strong_Password_123!

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=bree-products

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use an App Password — NOT your Gmail account password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bree.fit.india@gmail.com
SMTP_PASS=your_gmail_app_password_here

# ── Delhivery ─────────────────────────────────────────────────────────────────────
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_PICKUP_LOCATION=BREE FIT
# Actual filled-bottle/package weight in kg; required for shipment creation.
# Do not set this to the fixed 50 ml bottle volume.
DELHIVERY_BOTTLE_WEIGHT_KG=your_actual_filled_bottle_weight_kg

# ── WAPLIFY (primary/live WhatsApp provider) ─────────────────────────────────
# FIX (ISSUE-024): these 8 variables are used throughout
# services/whatsappNotificationService.js and services/whatsappService.js —
# WAPLIFY, not Meta Cloud API below, is what actually sends every
# WhatsApp message the app has ever sent (OTP, order/payment/subscription
# status updates, daily reminders, bulk-order updates). A fresh deployment
# following only the Meta section below would have zero real WhatsApp
# capability.
# Required. Base URL of your WAPLIFY account (obtained from WAPLIFY).
WAPLIFY_BASE_URL=https://server.waplify.io
# Required. WAPLIFY API key/bearer token (obtained from WAPLIFY dashboard).
WAPLIFY_API_KEY=your_waplify_api_key
# Optional. WAPLIFY template name used for OTP login messages. Defaults to
# "otp_login" if unset.
WAPLIFY_OTP_TEMPLATE=otp_login
# Required for the notifications that use them. Each is a WAPLIFY template
# name you configure in your WAPLIFY account — the exact string here must
# match a template that actually exists there.
WAPLIFY_TEMPLATE_ORDER_CONFIRMED=order_confirmed
WAPLIFY_TEMPLATE_ORDER_STATUS=order_status_update
WAPLIFY_TEMPLATE_SUBSCRIPTION_STATUS=subscription_status_update
WAPLIFY_TEMPLATE_PAYMENT_STATUS=payment_status
WAPLIFY_TEMPLATE_DAILY_REMINDER=daily_reminder
WAPLIFY_TEMPLATE_BULK_UPDATE=bulk_order_update

# ── Warehouse / pickup address (Delhivery shipments) ─────────────────────────
# FIX (ISSUE-024): used by getWarehouseConfig() in shippingController.js —
# baked into every Delhivery shipment/pickup payload as the pickup
# ("from") address. Without these, shipments are created with a blank/
# placeholder pickup address.
WAREHOUSE_NAME=BREE Warehouse
WAREHOUSE_ADDRESS=your_warehouse_street_address
WAREHOUSE_CITY=your_warehouse_city
WAREHOUSE_STATE=your_warehouse_state
WAREHOUSE_PINCODE=your_warehouse_pincode
WAREHOUSE_COUNTRY=India
WAREHOUSE_PHONE=your_warehouse_contact_phone
# GSTIN, if applicable — omit if not registered.
WAREHOUSE_GST=your_warehouse_gstin

# Meta WhatsApp Cloud API — webhook signature verification only. Not the
# live messaging provider (see WAPLIFY above); this only covers
# POST/GET /api/webhooks/meta, which today just logs incoming
# events/status callbacks. Leave unset to keep that endpoint closed
# (every request is rejected with no configured secret — see
# webhookController.js's verifyMetaWebhookSignature) if you don't use it.
#
# LOW-23 fix (Phase 4 doc audit): META_API_VERSION/META_PHONE_NUMBER_ID/
# META_ACCESS_TOKEN/META_OTP_TEMPLATE_NAME/META_OTP_LANGUAGE_CODE were
# removed from here — confirmed zero references anywhere in src/. They were
# leftovers from a planned-but-never-built outbound Meta Graph API send
# integration (this codebase sends WhatsApp only via WAPLIFY). Only the two
# vars below, which the inbound webhook receiver actually reads, remain.
# ────────────────────────────────────────────────────────────────────────────
# Required to verify GET /api/webhooks/meta's subscription handshake
# (hub.verify_token) — set this to whatever you configure in the Meta App
# dashboard's webhook subscription.
META_VERIFY_TOKEN=your_meta_webhook_verify_token
# Required to verify the X-Hub-Signature-256 header on every
# POST /api/webhooks/meta delivery — found in the Meta App dashboard
# under App Settings > Basic > App Secret. Never commit the real value.
META_APP_SECRET=your_meta_app_secret